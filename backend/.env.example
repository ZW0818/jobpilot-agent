# 留空时使用本地规则与关键词检索，不发送模型请求。
DASHSCOPE_API_KEY=
DASHSCOPE_CHAT_MODEL=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-rerank
# 在向量依赖兼容的环境中显式启用；聊天模型可独立使用。
RAG_ENABLE_VECTOR=false
# Windows SegmentAPI option (requires requirements-windows.txt):
# CHROMA_API_IMPL=chromadb.api.segment.SegmentAPI
# CHROMA_PERSIST_DIRECTORY=chroma_db_segment
# ANONYMIZED_TELEMETRY=false
